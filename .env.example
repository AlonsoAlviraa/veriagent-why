# Variable names only. Copy to .env (gitignored) and fill in locally. Never commit real values.
LLM_PROVIDER=
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL_S1=
NIGHTSHIFT_MODEL_S2=
# Pinning (app/nightshift.py): routed_model must contain these; mismatch fails the run.
NIGHTSHIFT_PIN_S1=
NIGHTSHIFT_PIN_S2=
# NIGHTSHIFT_PIN_CHECK=on (startup check) / NIGHTSHIFT_PIN_ENFORCE=on (per call); off only for mocks/simulator
NIGHTSHIFT_PIN_CHECK=
NIGHTSHIFT_PIN_ENFORCE=
NIGHTSHIFT_STATE_DIR=
NIGHTSHIFT_TIMEOUT_S1_S=
NIGHTSHIFT_TIMEOUT_S2_S=
NIGHTSHIFT_MAX_PROMPT_CHARS=
# LLM_FALLBACK=nvidia: if Nightshift is unreachable/5xx, call NVIDIA; receipt says fallback=true
LLM_FALLBACK=
ZETARIS_BACKEND=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
REASONING_MODEL=
FAST_MODEL=
NVIDIA_S2_THINKING=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_JDBC_JAR=
VA_PG_HOST=
VA_PG_PORT=
VA_PG_DB=
VA_PG_USER=
VA_PG_PASSWORD=
VA_PG_HOST_FROM_ZETARIS=
VA_REST_HOST_FROM_ZETARIS=
VA_REST_PORT=
METERLESS_BRIDGE_URL=
METERLESS_API_KEY=
SAMPLE_MODE=
# Zetaris is the default data path when ZETARIS_BACKEND=zetaris or ZETARIS_JDBC_URL is set; otherwise SAMPLE_MODE (DuckDB, synthetic) is used.
METERLESS_REQUIRED=
VA_LOG_DIR=
NIGHTSHIFT_API_KEY_FILE=
# Local Nightshift-compatible SIMULATOR (not Meterless Nightshift)
SIM_UPSTREAM=
SIM_RPM=
NIGHTSHIFT_SIM_TOKEN_FILE=
LOG_LEVEL=
PORT=
ZETARIS_VIEW_PREFIX=
